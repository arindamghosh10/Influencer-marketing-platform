# Copy to .env and fill in. Never commit .env.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://app:app@localhost:5432/influencer
REDIS_URL=redis://localhost:6379/0

# Encryption keys for PAN / bank fields (comma separated, newest first). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# Email: console in dev. For Brevo free tier: smtp+tls://LOGIN:KEY@smtp-relay.brevo.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@localhost

# AI: "rules" (free, offline) or "gemini" (free tier; get a key at https://aistudio.google.com)
LLM_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Instagram: "mock" (demo stats) or "graph" (needs a Meta app with approved permissions)
INSTAGRAM_PROVIDER=mock
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Business settings (margin is never shown to brands or creators)
PLATFORM_NAME=CreatorBridge
PLATFORM_MARGIN_BPS=5000
OFFER_EXPIRY_HOURS=48
BRAND_PAYMENT_HOURS=120

# Payments: "mock" (test button, no money moves) or "razorpay"
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<your-domain>/payments/webhooks/razorpay/ (payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Content and publishing
# Public https URL in production: Instagram fetches approved media from it
SITE_URL=http://localhost:8000
MAX_REVISIONS=2
MAX_UPLOAD_MB=250
VERIFICATION_DAYS=7
MIN_LIVE_DAYS=30

# Printed on GST invoices
PLATFORM_LEGAL_NAME=CreatorBridge Private Limited
PLATFORM_GSTIN=
PLATFORM_ADDRESS=
PLATFORM_STATE_CODE=27
INVOICE_PREFIX=CB
